---
// Decorative diagram: a small network with one highlighted path through it
// (a nod to tracing circuits in mechanistic interpretability).
const layers = 5;
const rows = 5;
const dx = 78;
const dy = 52;
const left = 30;
const top = 40;
const width = left * 2 + (layers - 1) * dx;
const height = top + (rows - 1) * dy + 44;

const x = (l: number) => left + l * dx;
const y = (r: number) => top + r * dy;

// The highlighted path: one node per layer.
const path = [2, 1, 3, 2, 0];

// Faint background edges: each node to its nearest neighbours in the next layer.
const edges: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let l = 0; l < layers - 1; l++) {
  for (let r = 0; r < rows; r++) {
    for (const d of [-1, 0, 1]) {
      const r2 = r + d;
      if (r2 >= 0 && r2 < rows) edges.push({ x1: x(l), y1: y(r), x2: x(l + 1), y2: y(r2) });
    }
  }
}
---

<figure class="net">
  <svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
    {
      Array.from({ length: layers }).map((_, l) => (
        <text class="label" x={x(l)} y={16} text-anchor="middle">
          L{l}
        </text>
      ))
    }
    {edges.map((e) => <line class="edge" {...e} />)}
    {
      path.slice(0, -1).map((r, l) => (
        <line
          class="hot"
          x1={x(l)}
          y1={y(r)}
          x2={x(l + 1)}
          y2={y(path[l + 1])}
          pathLength="1"
          style={`animation-delay:${l * 0.45}s`}
        />
      ))
    }
    {
      Array.from({ length: layers }).map((_, l) =>
        Array.from({ length: rows }).map((_, r) => (
          <circle
            class:list={['node', path[l] === r && 'on']}
            style={path[l] === r ? `animation-delay:${l * 0.45}s` : undefined}
            cx={x(l)}
            cy={y(r)}
            r="9"
          />
        )),
      )
    }
    <text class="label" x={left - 9} y={height - 8}>tracing a circuit, layer by layer</text>
  </svg>
</figure>

<style>
  .net {
    margin: 0;
    padding: 22px 22px 14px;
    border: 1px solid var(--card-line);
    border-radius: 16px;
    background: var(--card);
    box-shadow: var(--card-shadow);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .label {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--ink-3);
  }
  .edge {
    stroke: var(--line);
    stroke-width: 1;
  }
  .node {
    fill: var(--paper);
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .node.on {
    stroke: var(--node-on);
    animation: fire 4.5s ease-in-out infinite;
  }
  .hot {
    stroke: var(--trace);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trace 4.5s ease-in-out infinite;
  }
  @keyframes fire {
    0%,
    4% {
      fill: var(--paper);
    }
    12%,
    82% {
      fill: var(--node-on);
    }
    95%,
    100% {
      fill: var(--paper);
    }
  }
  @keyframes trace {
    0%,
    6% {
      stroke-dashoffset: 1;
    }
    16%,
    82% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    95%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .node.on {
      fill: var(--node-on);
    }
    .hot {
      stroke-dashoffset: 0;
    }
  }
</style>
