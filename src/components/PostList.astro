---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

{
  posts.length === 0 ? (
    <p class="empty">
      First posts are on the way. Subscribe via <a href="/rss.xml">RSS</a> to get them when they land.
    </p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time class="mono" datetime={post.data.date.toISOString()}>
            {fmt(post.data.date)}
          </time>
          <div>
            <a class="title" href={`/blog/${post.id}/`}>
              {post.data.title}
              {post.data.draft && <span class="draft mono">draft</span>}
            </a>
            <p>{post.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .empty {
    color: var(--ink-2);
    padding: 22px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    margin: 0;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  li:first-child {
    border-top: 1px solid var(--line);
  }
  time {
    color: var(--ink-3);
    padding-top: 5px;
  }
  .title {
    font-family: var(--serif);
    font-size: 1.25rem;
    text-decoration: none;
  }
  .draft {
    margin-left: 10px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--seal-soft);
    color: var(--seal);
    vertical-align: middle;
  }
  p {
    margin: 4px 0 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
