---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/site';
---

<Base title="Projects" description="Selected projects by Hantang Li: generative AI, computer vision research, and systems analysis.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>Things I’ve built and studied</h1>
      <p>From a patented generative layout system to GPU cluster analysis: mostly AI, with a systems streak.</p>
    </header>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding-bottom: 56px;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
