---
import Base from '../layouts/Base.astro';
import HeroLog from '../components/HeroLog.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import { site, experience, projects, fmtMonth } from '../data/site';
import { getPosts } from '../lib/posts';

const featured = projects.filter((p) => p.featured);
const posts = (await getPosts()).slice(0, 3);

// Night-sky stars for dark mode. Seeded so the sky is the same on every build.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(1889); // the year of The Starry Night
const stars = Array.from({ length: 110 }, (_, i) => ({
  x: +(rand() * 1600).toFixed(1),
  y: +(rand() * 800).toFixed(1),
  r: +(0.5 + rand() * rand() * 1.5).toFixed(2),
  o: +(0.25 + rand() * 0.6).toFixed(2),
  gold: i % 9 === 0,
  twinkle: i % 6 === 0,
  near: i % 23 === 3, // a handful of closer stars with a soft halo, for depth
  delay: +(rand() * 6).toFixed(1),
}));
---

<Base>
  <div class="wash">
  <svg class="stars" viewBox="0 0 1600 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="halo">
        <stop offset="0" stop-color="#dbe7ff" stop-opacity="0.55" />
        <stop offset="1" stop-color="#dbe7ff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="halo-gold">
        <stop offset="0" stop-color="#f3ce82" stop-opacity="0.55" />
        <stop offset="1" stop-color="#f3ce82" stop-opacity="0" />
      </radialGradient>
    </defs>
    {
      stars.map((s) => (
        <>
          {s.near && <circle cx={s.x} cy={s.y} r="11" fill={s.gold ? 'url(#halo-gold)' : 'url(#halo)'} />}
          <circle
            class:list={[s.gold && 'gold', s.twinkle && 'twinkle']}
            cx={s.x}
            cy={s.y}
            r={s.near ? 1.9 : s.r}
            opacity={s.near ? 0.95 : s.o}
            style={s.twinkle ? `animation-delay:-${s.delay}s` : undefined}
          />
        </>
      ))
    }
  </svg>
  <section class="hero wrap">
    <div class="intro">
      {
        site.openToWork && (
          <a class="status mono" href="#contact">
            <span class="dot" aria-hidden="true" />
            Open to new opportunities
          </a>
        )
      }
      <p class="eyebrow">{site.role} · {site.location}</p>
      <h1>
        I build <em>generative AI</em> that ships, on <em>infrastructure</em> that holds.
      </h1>
      <p class="lede">
        I’m Hantang Li <span class="zh">({site.nameZh})</span>. I’ve built GenAI products as an early engineer at a
        Techstars-backed startup, done computer vision research at the University of Toronto, and most recently worked
        on large-scale distributed infrastructure at AWS. AI is where my curiosity lives: I follow the frontier
        closely, and right now I’m studying how models work on the inside.
      </p>
      <div class="cta">
        <a class="btn primary" href="/projects/">See my work</a>
        <a class="btn" href="/resume/">Resume</a>
        <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
      </div>
    </div>
    <HeroLog />
  </section>
  </div>

  <section class="now">
    <div class="wrap now-row">
      <span class="mono now-tag">Now · {site.now.updated}</span>
      <p>{site.now.text}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected work</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
        <a href="/resume/">Full resume →</a>
      </div>
      <ol class="xp">
        {
          experience.map((j, i) => (
            <li>
              <span class="seq mono">{String(experience.length - i).padStart(3, '0')}</span>
              <span class="when mono">
                {fmtMonth(j.start)} – {fmtMonth(j.end)}
              </span>
              <div>
                <h3>
                  {j.role} <span class="at">· {j.org}</span>
                </h3>
                <p>{j.oneLine}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Writing</h2>
        <a href="/blog/">All posts →</a>
      </div>
      <PostList posts={posts} />
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="wrap">
      <h2>Let’s talk.</h2>
      {
        site.openToWork ? (
          <p>
            I’m open to new opportunities in AI: applied AI engineering, interpretability, and the infrastructure
            around them. If you’re hiring, or just want to compare notes, email is the fastest way to reach me.
          </p>
        ) : (
          <p>
            I’m always happy to chat about distributed systems, applied LLMs, or the path from research to production.
          </p>
        )
      }
      <div class="cta">
        <a class="btn primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn" href={site.links.linkedin} rel="noopener">LinkedIn</a>
        <a class="btn" href={site.links.github} rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    padding-top: 88px;
    padding-bottom: 88px;
  }
  /* Soft "water lilies" wash behind the hero */
  .wash {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(40% 60% at 80% 28%, var(--wash-a), transparent 70%),
      radial-gradient(34% 50% at 10% 18%, var(--wash-b), transparent 70%),
      radial-gradient(46% 40% at 50% 100%, var(--wash-c), transparent 70%);
  }
  .hero {
    position: relative;
  }
  /* Stars only come out at night */
  .stars {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    fill: #dbe7ff;
  }
  :global(:root[data-theme='dark']) .stars {
    display: block;
  }
  .stars .gold {
    fill: var(--accent-2);
  }
  .stars .twinkle {
    animation: twinkle 5s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.95;
    }
  }
  .now {
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }
  .now-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .now-tag {
    color: var(--accent-2);
    font-weight: 600;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .now p {
    margin: 0;
  }
  @media (max-width: 560px) {
    .now-row {
      flex-direction: column;
      gap: 4px;
    }
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
  }
  .status:hover {
    border-color: var(--seal);
    color: var(--ink);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--seal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--seal) 28%, transparent);
  }
  .contact {
    scroll-margin-top: 60px;
  }
  h1 {
    font-size: clamp(2.3rem, 5.2vw, 3.7rem);
    margin: 16px 0 22px;
  }
  h1 em {
    font-style: italic;
    color: var(--seal);
    background: var(--em);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-right: 0.06em; /* keep the italic overhang inside the clipped area */
  }
  /* Stars fade out behind the text block (dark mode only) */
  .intro {
    position: relative;
    isolation: isolate;
  }
  :global(:root[data-theme='dark']) .intro::before {
    content: '';
    position: absolute;
    inset: 0 -12px;
    z-index: -1;
    background: var(--paper);
    opacity: 0.92;
    filter: blur(28px);
    pointer-events: none;
  }
  .lede {
    font-size: 1.12rem;
    color: var(--ink-2);
    max-width: 580px;
  }
  .zh {
    white-space: nowrap;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .xp {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .xp li {
    display: grid;
    grid-template-columns: 44px 170px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .xp li:first-child {
    border-top: 1px solid var(--line);
  }
  .seq {
    color: var(--seal);
  }
  .when {
    color: var(--ink-3);
  }
  .xp h3 {
    font-size: 1.2rem;
  }
  .at {
    color: var(--ink-2);
  }
  .xp p {
    margin: 4px 0 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .contact h2 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-bottom: 14px;
  }
  .contact p {
    max-width: 560px;
    color: var(--ink-2);
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 52px;
      padding-bottom: 56px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .xp li {
      grid-template-columns: 40px 1fr;
    }
    .xp .when {
      grid-column: 2;
      grid-row: 1;
    }
    .xp li > div {
      grid-column: 2;
    }
  }
</style>
